{
  "name": "community-feed",
  "version": "0.1.0",
  "private": true,
  "description": "게시판 기반 커뮤니티 피드와 사용자 행동 이벤트 수집·집계 파이프라인",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-force-exit --test-concurrency=4 \"test/**/*.test.js\"",
    "events:recent": "node scripts/recent-events.js",
    "bench:popular": "node scripts/bench-popular.js",
    "bench:load": "node scripts/bench-load.js",
    "search:index": "node scripts/create-search-index.js",
    "dq:check": "node scripts/dq-check.js",
    "dq:fix-counts": "node scripts/dq-fix-counts.js",
    "bench:dq": "node scripts/bench-dq.js",
    "bench:design": "node scripts/bench-design.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "method-override": "^3.0.0",
    "mongodb": "^5.9.2",
    "multer": "^2.4.0",
    "multer-s3": "^3.0.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "mongodb-memory-server": "^10.4.3",
    "socket.io-client": "^4.8.4"
  }
}
