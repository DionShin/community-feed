# .env로 복사한 뒤 값을 채워서 사용. .env는 커밋하지 않음
PORT=8080
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
DB_NAME=community
SESSION_SECRET=<긴 랜덤 문자열>

# 검색 방식. atlas(기본값)는 Atlas Search 인덱스 필요(npm run search:index)
# Atlas가 아닌 MongoDB에서는 basic 사용
SEARCH_MODE=atlas

# 이미지 업로드용. S3_BUCKET이 비어 있으면 업로드 없이 동작함
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_KEY=
S3_SECRET=
