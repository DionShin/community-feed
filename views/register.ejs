<%- include('partials/head', { title: '회원가입' }) %>
<%- include('partials/nav') %>
<form class="form-box" action="/register" method="POST">
  <h4>회원가입</h4>
  <% if (error) { %><p class="error-text"><%= error %></p><% } %>
  <input name="username" placeholder="아이디 (영문 소문자, 숫자 4~20자)" autocomplete="username" required>
  <input name="password" type="password" placeholder="비밀번호 (8자 이상)" autocomplete="new-password" required>
  <input name="nickname" placeholder="닉네임 (2~12자)" required>
  <button type="submit">가입</button>
</form>
<%- include('partials/foot') %>
