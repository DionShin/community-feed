<%- include('partials/head', { title: '채팅' }) %>
<%- include('partials/nav') %>
<div class="white-bg">
  <% if (rooms.length === 0) { %>
    <div class="list-box"><p>아직 채팅이 없습니다. 글 상세 화면에서 작성자에게 문의할 수 있습니다.</p></div>
  <% } %>
  <% rooms.forEach((room) => { %>
    <div class="list-box">
      <h4><a href="/chats/<%= room._id %>"><%= room.postTitle %></a></h4>
      <p><%= room.lastMessage || '아직 메시지가 없습니다.' %></p>
      <p class="meta">
        <%= room.authorId.equals(currentUser._id) ? '내 글에 온 문의' : '내가 보낸 문의' %>
        · <%= formatDate(room.lastMessageAt) %>
      </p>
    </div>
  <% }) %>
</div>
<%- include('partials/foot') %>
