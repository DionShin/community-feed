<%- include('partials/head', { title: '글쓰기' }) %>
<%- include('partials/nav') %>
<form class="form-box" action="/posts" method="POST" enctype="multipart/form-data">
  <h4>글쓰기</h4>
  <% if (error) { %><p class="error-text"><%= error %></p><% } %>
  <%- include('partials/post-fields', { values: input }) %>
  <% if (uploadEnabled) { %>
    <input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
    <p class="meta">이미지는 최대 3장, 한 장에 5MB까지 올릴 수 있습니다.</p>
  <% } %>
  <button type="submit">등록</button>
</form>
<%- include('partials/foot') %>
